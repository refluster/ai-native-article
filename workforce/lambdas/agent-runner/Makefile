# Builds the wf-agent-runner Lambda. Bundles handler.ts with esbuild
# AND copies workforce/agents/** so the runner can read each persona's
# system.md at runtime. Same shape as seed-agents/Makefile.
#
# Skill handler.ts files (workforce/skills/{name}/handler.ts) are pulled
# into the bundle via the import graph rooted in shared/skill-registry-generated.ts
# — that file is build-time generated by ../../scripts/build-skill-registry.mjs,
# so adding a new deterministic skill = drop a folder, no Makefile edits.
#
# CWD when SAM invokes this is workforce/lambdas/agent-runner.

build-WfAgentRunnerFunction:
	node ../../scripts/build-skill-registry.mjs
	../node_modules/.bin/esbuild handler.ts \
		--bundle \
		--platform=node \
		--target=node24 \
		--format=esm \
		--external:@aws-sdk/* \
		--outfile=$(ARTIFACTS_DIR)/handler.mjs
	mkdir -p $(ARTIFACTS_DIR)/agents $(ARTIFACTS_DIR)/skills
	cp -R ../../agents/. $(ARTIFACTS_DIR)/agents/
	cp -R ../../skills/. $(ARTIFACTS_DIR)/skills/
