#!/usr/bin/env bash
# Local mirror of the cheap CI gates, so the same failures surface at push-time
# instead of PR-time. Imported pattern from mononaware's .githooks/ (their pre-
# push runs the repo-local gates against the working tree).
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Bypass (sparingly — CI remains the backstop):
#   git push --no-verify
#
# Only the fast, dependency-free, network-free gates run here. The L1-citation
# gate (R-11) needs a PR body and the corpus-truncation gate (R-10) needs a
# fetch-notion run, so both stay CI-only.

set -euo pipefail

echo "[pre-push] design-token lint (R-2)…"
node scripts/lint-design-tokens.mjs

echo "[pre-push] GAS manifest check (R-1)…"
node newsletter/pipeline/check-gas-manifest.mjs

echo "[pre-push] governance registries (R-12)…"
node scripts/check-governance-registries.mjs

echo "[pre-push] ✓ all local gates passed"
