#!/usr/bin/env node
// {{NAME}}/{{WRITE_SCRIPT}} — deterministic write for the "{{NAME}}" Cadence,
// invoked by the CCR agent-runner AFTER it has *generated* the content. The LLM
// owns the judgment (body / structured fields); this script owns the
// structurally-exact write so the failure class "LLM hand-edits JSON and
// guesses the schema wrong" cannot recur. Modeled on
// workforce/skills/feed-post/post-feed.mjs — the canonical Cadence write.
//
// It POSTs to an authenticated endpoint with the project-scoped credential
// injected per-fire (credentials['{{CREDENTIAL_KEY}}']). The script does NOT
// touch the repo, does NOT open a PR — the write lands directly in the backing
// store. No human approval gate.
//
// Body is read from a FILE (not an arg) so multi-line / Unicode prose can't be
// mangled by shell quoting. The write CREDENTIAL is injected per-fire; the
// endpoint URL is NOT a secret and is the single source of truth right here.
//
// Usage:
//   {{ENV_TOKEN}}=<from credentials['{{CREDENTIAL_KEY}}']> \
//     node workforce/skills/{{NAME}}/{{WRITE_SCRIPT}} \
//       --agent <slug> --body-file /tmp/body.md [--skill-version 0.1.0]
//
// Exit codes:
//   0  — written (HTTP 2xx)
//   1  — bad args / env / body-file unreadable
//   2  — endpoint rejected (HTTP 401 auth / 422 validation)
//   3  — network / unexpected error

import { readFileSync } from "node:fs";

// Single source of truth for this Cadence's write endpoint. Override with
// {{ENV_TOKEN}}_API_URL only for non-prod / dev stages.
// TODO(scaffold): confirm this is the correct authenticated endpoint.
const DEFAULT_API_URL = "{{DEFAULT_API_URL}}";

function arg(name) {
  const i = process.argv.indexOf(`--${name}`);
  return i >= 0 && i + 1 < process.argv.length ? process.argv[i + 1] : undefined;
}

const apiUrl = process.env["{{ENV_TOKEN}}_API_URL"] || DEFAULT_API_URL;
const token = process.env["{{ENV_TOKEN}}"];
const agent = arg("agent");
const bodyFile = arg("body-file");
const skillVersion = arg("skill-version");

if (!token) { console.error("{{WRITE_SCRIPT}}: {{ENV_TOKEN}} env var is required (from credentials['{{CREDENTIAL_KEY}}'])"); process.exit(1); }
if (!agent) { console.error("{{WRITE_SCRIPT}}: --agent <slug> is required"); process.exit(1); }
if (!bodyFile) { console.error("{{WRITE_SCRIPT}}: --body-file <path> is required"); process.exit(1); }
if (apiUrl.startsWith("TODO_")) { console.error("{{WRITE_SCRIPT}}: DEFAULT_API_URL is still a scaffold placeholder — set the real endpoint"); process.exit(1); }

let body;
try {
  body = readFileSync(bodyFile, "utf8");
} catch (err) {
  console.error(`{{WRITE_SCRIPT}}: cannot read --body-file "${bodyFile}": ${err instanceof Error ? err.message : String(err)}`);
  process.exit(1);
}

// W-1 editorial guard (client side; the endpoint should re-run it server side).
// A degraded body fails loud here rather than landing on the backing store.
const ARTEFACTS = ["as an ai", "i apologize", "i'm sorry", "certainly!", "sure, ", "here is the", "here's the"];
const head = body.trimStart().slice(0, 50).toLowerCase();
if (body.trim().length === 0) { console.error("{{WRITE_SCRIPT}}: body is empty (W-1)"); process.exit(1); }
if (ARTEFACTS.some((a) => head.startsWith(a))) { console.error(`{{WRITE_SCRIPT}}: body opens with an LLM-failure artefact (W-1): "${head}"`); process.exit(1); }

const payload = { agent_slug: agent, body };
if (skillVersion) payload.skill_version = skillVersion;

console.error(`{{WRITE_SCRIPT}}: POST ${apiUrl}`);

try {
  const res = await fetch(apiUrl, {
    method: "POST",
    headers: { "content-type": "application/json", authorization: `Bearer ${token}` },
    body: JSON.stringify(payload),
  });
  const text = await res.text().catch(() => "");
  if (res.status >= 200 && res.status < 300) {
    console.log(`{{WRITE_SCRIPT}}: written — ${text}`);
    process.exit(0);
  }
  if (res.status === 401 || res.status === 422) {
    console.error(`{{WRITE_SCRIPT}}: rejected (HTTP ${res.status}): ${text.slice(0, 400)}`);
    process.exit(2);
  }
  console.error(`{{WRITE_SCRIPT}}: unexpected HTTP ${res.status}: ${text.slice(0, 400)}`);
  process.exit(3);
} catch (err) {
  console.error(`{{WRITE_SCRIPT}}: fetch failed: ${err instanceof Error ? err.message : String(err)}`);
  process.exit(3);
}
