{
  "name": "ai-native-article",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "newsletter/app",
    "workforce/app",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kohuehara/article",
    "dev:article": "npm run dev -w @kohuehara/article",
    "dev:workforce": "npm run dev -w @kohuehara/workforce",
    "build": "npm run build -w @kohuehara/article && npm run build -w @kohuehara/workforce",
    "build:article": "npm run build -w @kohuehara/article",
    "build:workforce": "npm run build -w @kohuehara/workforce",
    "preview:article": "npm run preview -w @kohuehara/article",
    "preview:workforce": "npm run preview -w @kohuehara/workforce",
    "build:agents": "node workforce/scripts/build-agent-manifest.mjs",
    "fetch-notion": "node newsletter/pipeline/fetch-notion.mjs",
    "backfill-en": "node newsletter/pipeline/backfill-en.mjs",
    "lint:tokens": "node scripts/lint-design-tokens.mjs",
    "check-truncation": "node scripts/check-corpus-truncation.mjs",
    "check-proxy-bootstrap": "node scripts/check-proxy-bootstrap.mjs",
    "check-corpus-freshness": "node scripts/check-corpus-freshness.mjs",
    "check-base-path": "node scripts/check-base-path.mjs",
    "check-live-base-path": "node scripts/check-live-base-path.mjs",
    "test:scripts": "node --test scripts/lib/*.test.mjs workforce/pipeline/knowledge-backup/lib/*.test.mjs",
    "check-l1-citation": "node scripts/check-l1-citation.mjs",
    "check-registries": "node scripts/check-governance-registries.mjs",
    "content-insights": "node scripts/content-insights.mjs",
    "sitemap": "node newsletter/pipeline/generate-sitemap.mjs",
    "workforce:naming": "node workforce/scripts/validate-naming.mjs",
    "workforce:skills": "node workforce/scripts/validate-skills.mjs",
    "workforce:projects": "node workforce/scripts/validate-projects.mjs",
    "workforce:tools": "node workforce/scripts/validate-tools.mjs",
    "workforce:tool-registry:check": "node workforce/scripts/build-tool-registry.mjs --check",
    "workforce:projects:seed": "node workforce/scripts/seed-projects.mjs",
    "workforce:skill-registry": "node workforce/scripts/build-skill-registry.mjs",
    "workforce:skill-registry:check": "node workforce/scripts/build-skill-registry.mjs --check",
    "workforce:skill-manifest:check": "node workforce/scripts/build-agent-manifest.mjs --check-skills",
    "workforce:openapi-routes": "node workforce/scripts/check-openapi-routes.mjs",
    "workforce:api-routes": "node workforce/scripts/check-api-routes.mjs",
    "workforce:skill-spec-drift": "node workforce/scripts/check-skill-spec-drift.mjs",
    "workforce:skill-body-version": "node workforce/scripts/check-skill-body-version.mjs",
    "workforce:skill-version-sync": "node workforce/scripts/check-skill-version-sync.mjs",
    "workforce:scan-drain": "node workforce/scripts/check-scan-drain.mjs",
    "workforce:no-run-deliv-writes": "node workforce/scripts/check-run-deliv-writes.mjs",
    "workforce:escalation-labels": "node workforce/scripts/check-escalation-labels.mjs",
    "workforce:cycle-count": "node workforce/scripts/check-cycle-count.mjs",
    "workforce:pr-sweep": "node workforce/skills/pr-autopilot/pr-autopilot-sweep.mjs",
    "workforce:pr-metrics": "node workforce/scripts/build-pr-metrics.mjs",
    "workforce:pr-metrics-gh": "node workforce/scripts/build-pr-metrics-github.mjs",
    "workforce:human-touch": "node workforce/scripts/build-human-touch.mjs",
    "workforce:perf-backfill": "node workforce/scripts/backfill-performance-lifecycle.mjs"
  }
}
