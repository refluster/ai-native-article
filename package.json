{
  "name": "ai-native-article",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kohuehara/article",
    "dev:article": "npm run dev -w @kohuehara/article",
    "dev:workforce": "npm run dev -w @kohuehara/workforce",
    "build": "npm run build -w @kohuehara/article && npm run build -w @kohuehara/workforce",
    "build:article": "npm run build -w @kohuehara/article",
    "build:workforce": "npm run build -w @kohuehara/workforce",
    "preview:article": "npm run preview -w @kohuehara/article",
    "preview:workforce": "npm run preview -w @kohuehara/workforce",
    "build:agents": "node scripts/build-agent-manifest.mjs",
    "fetch-notion": "node scripts/fetch-notion.mjs",
    "check-gas": "node scripts/check-gas-manifest.mjs",
    "push-gas": "npm run check-gas && clasp push --force",
    "deploy-gas": "npm run push-gas && clasp deploy -i AKfycbwT9brOVSZqKzpf9-yZ_O8BHKJiFuZxwxawKK4FAhBwq-sdloyv56rDgNec9uQ2N4u-",
    "lint:tokens": "node scripts/lint-design-tokens.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "workforce:naming": "node workforce/scripts/validate-naming.mjs",
    "workforce:agents": "node workforce/scripts/validate-agent-json.mjs",
    "workforce:skills": "node workforce/scripts/validate-skills.mjs",
    "workforce:projects": "node workforce/scripts/validate-projects.mjs",
    "workforce:projects:seed": "node workforce/scripts/seed-projects.mjs",
    "workforce:skill-registry": "node workforce/scripts/build-skill-registry.mjs",
    "workforce:skill-registry:check": "node workforce/scripts/build-skill-registry.mjs --check",
    "workforce:api-routes": "node workforce/scripts/check-api-routes.mjs"
  }
}
